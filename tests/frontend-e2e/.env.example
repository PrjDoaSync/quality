# Copie este arquivo para .env e ajuste os valores do seu ambiente.
# A suite le estas variaveis via python-dotenv.

# URL base da aplicacao sob teste (SPA do DoaSync).
# Enquanto o front real nao existe, aponte para o ambiente que quiser validar.
BASE_URL=http://localhost:5173

# Navegador: chrome | firefox
BROWSER=chrome

# Executar sem abrir janela (util em CI). true | false
HEADLESS=false

# Timeout implicito/explicito padrao, em segundos.
WAIT_TIMEOUT=10
